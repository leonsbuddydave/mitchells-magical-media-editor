{
  "name": "mitchells-magical-media-editor",
  "productName": "Magical Media Editor",
  "version": "0.1.0",
  "private": true,
  "description": "Split long tape rips into tagged clips without losing quality.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm build:native && electron-vite dev",
    "build": "electron-vite build",
    "start": "pnpm build:native && electron-vite build && electron-vite preview",
    "dist": "pnpm build:native && electron-vite build && electron-builder --mac",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm build:native && electron-vite build && playwright test",
    "build:native": "sh scripts/build-native.sh"
  },
  "build": {
    "appId": "com.leonsbuddydave.magicalmediaeditor",
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/build/places",
        "to": "places"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
